{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "ignorePatterns": ["dist/**", "src-tauri/**"],
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/domain/attendantPersistence.ts",
    "src/domain/attendants.ts",
    "src/domain/databaseGovernance.ts",
    "src/domain/navigation.ts",
    "src/domain/phone.ts",
    "src/theme/appearance.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 85
  },
  "reporters": ["clear-text", "html", "progress"]
}
